{
  "name": "silence-remover",
  "version": "1.0.0",
  "description": "Detect and remove silences, and normalize loudness — Electron desktop app.",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "node test/audio.test.js"
  },
  "license": "MIT",
  "build": {
    "appId": "com.hyperlog.silenceremover",
    "productName": "Silence Remover + Normalization",
    "files": [
      "main.js",
      "preload.js",
      "audio.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
